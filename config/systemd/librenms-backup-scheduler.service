[Unit]
Description=LibreNMS Backup & Restore schedule evaluator
After=mariadb.service librenms-backup-dispatch.service

[Service]
Type=oneshot
User=@BR_APP_USER@
Group=@BR_APP_GROUP@
Environment=BR_CONF=/etc/librenms-backup/br.conf
Environment=PYTHONPATH=@BR_PREFIX@/worker
WorkingDirectory=@BR_PREFIX@/worker
ExecStart=/usr/bin/python3 -m br.worker scheduler-tick
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=@BR_BACKUP_ROOT@ @BR_LOG_DIR@ @BR_STATE_DIR@ @BR_RUN_DIR@
UMask=0027
